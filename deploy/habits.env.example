# Umgebung des habits-Dienstes (coHabit-Backend und Wald der Fokus-App). Liegt als
# /etc/habits.env:
#   sudo chown root:habits /etc/habits.env && sudo chmod 640 /etc/habits.env
#
# Nichts davon abtippen: setup-habits.sh setzt die ersten beiden Zeilen,
# setup-cohabit.sh den Rest - jeweils aus den Stellen, an denen die Werte ohnehin
# stehen, und immer nur Zeile fuer Zeile (die Datei wird nie neu geschrieben).

# Der geteilte Privat-Modus-Token von fherrmann.com (/etc/nginx/conf.d/private-mode.conf).
# Cookie fh_private bzw. Bearer = Felix. Oeffnet ausserdem den Kalorienzaehler fuer
# Felix' "Track food".
FH_PRIVATE_TOKEN=changeme

# Der Token des Weight Trackers (/etc/health-viz.env) - fuer Felix' Schritte.
WEIGHT_APP_TOKEN=changeme

# Die Healthy-Personen, wortgleich wie in /etc/food.env. Jede kommt mit ihrem Token
# (Bearer oder health_token-Cookie) in coHabit und hat FOOD/STEPS_WEEKLY als Quelle.
HEALTH_OWNER=felix
HEALTH_TOKENS=torben:0123456789abcdef0123456789abcdef

# Wohin Einladungs-, Freundes- und Setup-Links zeigen.
COHABIT_PUBLIC_URL=https://fherrmann.com/cohabit

# Push an iOS (APNs, token-basiert): Kopie des Team-Schluessels, Topic der App.
# Sandbox, solange Felix aus Xcode installiert (TestFlight: https://api.push.apple.com).
APNS_KEY_FILE=/etc/apns-cohabit.p8
APNS_KEY_ID=changeme
APNS_TEAM_ID=ZWFV263P59
APNS_TOPIC=com.fherrmann.cohabit
APNS_HOST=https://api.sandbox.push.apple.com

# Push an Android (Firebase, Projekt fherrmann-apps). Ohne Datei kein Push, sonst nichts kaputt.
FCM_SERVICE_ACCOUNT_FILE=/etc/fcm-cohabit.json

# Die Android-App (cohabit.apk + latest.json), gefuellt von tools/publish.sh.
COHABIT_ANDROID_DIR=/opt/cohabit-android

# GIF-Suche im Chat (KLIPY, Partner-Panel). Ohne Schluessel keine Suche, eigene GIFs gehen
# trotzdem. Setzen mit deploy/set-klipy-key.sh.
KLIPY_API_KEY=changeme

# Optional, wenn die Nachbardienste woanders laufen:
# FOOD_URL=http://127.0.0.1:48180
# WEIGHT_URL=http://127.0.0.1:48173
