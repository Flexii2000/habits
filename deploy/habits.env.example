# Umgebung des habits-Dienstes. Liegt als /etc/habits.env:
#   sudo chown root:habits /etc/habits.env && sudo chmod 640 /etc/habits.env
#
# deploy/setup-habits.sh schreibt beide Werte selbst - aus den Stellen, an
# denen sie ohnehin stehen. Abtippen waere die Stelle fuer einen Dreher, den
# man erst an "Kein Zugang" bemerkt.

# Der geteilte Privat-Modus-Token von fherrmann.com. Gehoert nicht dieser App:
# er steht in /etc/nginx/conf.d/private-mode.conf. Prueft den Cookie der App
# UND oeffnet den Kalorienzaehler fuer "Track food".
FH_PRIVATE_TOKEN=changeme

# Der Token des Weight Trackers (/etc/health-viz.env) - fuer die Schritte.
WEIGHT_APP_TOKEN=changeme
