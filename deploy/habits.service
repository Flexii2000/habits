# systemd-Unit fuer Habits (fherrmann.com/habits).
#
# Installiert deploy/setup-habits.sh. Von Hand:
#   sudo cp deploy/habits.service /etc/systemd/system/habits.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now habits
#
# Die Token stehen in /etc/habits.env (siehe EnvironmentFile), lesbar nur fuer
# root und den Dienstnutzer - nirgends im Repo.

[Unit]
Description=Habits (fherrmann.com/habits)
After=network.target

[Service]
User=habits
Group=habits
WorkingDirectory=/opt/habits
EnvironmentFile=/etc/habits.env
# Absoluter Pfad: das JDK liegt unter /opt/java und ist nicht im PATH eines
# systemd-Dienstes (wie bei food.service).
ExecStart=/opt/java/jdk-25.0.1+8/bin/java -jar /opt/habits/app.jar
Restart=on-failure
RestartSec=5

# Der Dienst braucht nichts ausser seinem Datenverzeichnis. Anders als beim
# Kalorienzaehler startet er keine Claude-Session - NoNewPrivileges darf also an.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/habits/data

[Install]
WantedBy=multi-user.target
