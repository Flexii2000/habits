# systemd-Unit fuer habits - das Backend von coHabit (fherrmann.com/cohabit) und den
# Wald der Fokus-App (fherrmann.com/habits/api/focus).
#
# Installiert deploy/setup-habits.sh, aufgefrischt von setup-cohabit.sh. Von Hand:
#   sudo cp deploy/habits.service /etc/systemd/system/habits.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now habits
#
# Die Token stehen in /etc/habits.env (siehe EnvironmentFile), lesbar nur fuer
# root und den Dienstnutzer - nirgends im Repo.

[Unit]
Description=Habits / coHabit (fherrmann.com/cohabit)
After=network.target

[Service]
User=habits
Group=habits
WorkingDirectory=/opt/habits
EnvironmentFile=/etc/habits.env
# Absoluter Pfad: das JDK liegt unter /opt/java und ist nicht im PATH eines
# systemd-Dienstes (wie bei food.service).
ExecStart=/opt/java/jdk-25.0.1+8/bin/java -jar /opt/habits/app.jar
Restart=on-failure
RestartSec=5

# Der Dienst schreibt nur in sein Datenverzeichnis (samt data/cohabit/ mit den
# Fotos). Lesen darf er, was er braucht: /etc/apns-cohabit.p8, /etc/fcm-cohabit.json
# und die Android-App in /opt/cohabit-android. Anders als beim Kalorienzaehler
# startet er keine Claude-Session - NoNewPrivileges darf also an.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/habits/data

[Install]
WantedBy=multi-user.target
